# Next.js / frontend environment for hireloop-client
# Setup: `cp .env.example .env` then fill in real values. Never commit `.env`.
#
# ── RULE ──────────────────────────────────────────────────────────────
# NO NEXT_PUBLIC_ vars in this project. The browser only calls same-origin
# /api/* routes, so every variable below is server-only and can be stored
# on Vercel as type "Secret". That is what removes the warning:
# "Remove the public framework prefix to keep this value private."
# ───────────────────────────────────────────────────────────────────────

# HireLoop API server (include /api, no trailing slash)
# Local: http://localhost:5050/api
# Production (Vercel Secret): https://YOUR-SERVER.onrender.com/api
BACKEND_URL=http://localhost:5050/api

# Better Auth canonical app URL (this Next.js app serves /api/auth/*)
# Local: http://localhost:3000
# Production (Vercel Secret): https://YOUR-APP.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Random 32+ char string: `openssl rand -base64 32`
# Production: set on Vercel as Secret. `next build` fails fast without it.
BETTER_AUTH_SECRET=dev-only-change-me-replace-with-openssl-rand-base64-32

# Mongo connection for Better Auth tables (server-only)
# Local: mongodb://127.0.0.1:27017
# Production: mongodb+srv://... (set on Vercel as Secret)
MONGO_DB_URI=mongodb://127.0.0.1:27017

# DB name for auth collections (server-only)
AUTH_DB_NAME=hireloop_db

# Stripe publishable key (pk_test_...) — server-only here, served at runtime
# via /api/config. Get it from https://dashboard.stripe.com/test/apikeys
# (Test mode → "Publishable key"). Hosted Checkout only needs the
# SECRET key on the server (.env of hireloop-server).
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
